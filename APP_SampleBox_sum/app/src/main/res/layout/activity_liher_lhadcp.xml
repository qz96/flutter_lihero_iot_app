<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_white_ffffff">

    <!-- 滚动容器 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 交互模式容器 -->
            <LinearLayout
                android:id="@+id/ll_ui_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


            <!-- 常用功能区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/shape_background_white_radiu_15dp"
                android:padding="15dp">

                <!-- 标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADCP常用功能"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_black_333333"
                    android:layout_marginBottom="12dp"/>

                <!-- 功能按钮网格 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:horizontalSpacing="10dp"
                    android:verticalSpacing="10dp">

                    <!-- 单点测量 -->
                    <Button
                        android:id="@+id/btn_single_measure"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:text="单点测量"
                        android:textSize="14sp"
                        android:layout_margin="10dp"
                        android:textColor="@color/white"
                        android:background="@drawable/shape_background_green_radiu_10dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:drawableTop="@mipmap/ic_adcp_measure"/>

                    <!-- 历史数据 -->
                    <Button
                        android:id="@+id/btn_history_data"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:text="历史数据"
                        android:textSize="14sp"
                        android:layout_margin="10dp"
                        android:textColor="@color/white"
                        android:background="@drawable/shape_background_blue_55_radiu_5dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:drawableTop="@mipmap/ic_history_data" />

                    <!-- 校准 -->
                    <Button
                        android:id="@+id/btn_calibration"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:text="校准"
                        android:textSize="14sp"
                        android:layout_margin="10dp"
                        android:textColor="@color/white"
                        android:background="@drawable/shape_background_app_color_radiu_10dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:drawableTop="@mipmap/ic_dev_calibration"/>

                    <!-- 上传设置 -->
                    <Button
                        android:id="@+id/btn_upload_settings"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:text="上传设置"
                        android:textSize="14sp"
                        android:layout_margin="10dp"
                        android:textColor="@color/white"
                        android:background="@drawable/shape_background_pink_radiu_10dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:drawableTop="@mipmap/ic_updata_setting"/>

                    <!-- 多线多点测量 -->
                    <Button
                        android:id="@+id/btn_multi_measure"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:text="多线多点测量"
                        android:textSize="14sp"
                        android:layout_margin="10dp"
                        android:textColor="@color/white"
                        android:background="@drawable/shape_background_gray_color_radiu_15dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:drawableTop="@mipmap/ic_adcp_measures"/>
                </GridLayout>
            </LinearLayout>

            <!-- 设备信息区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/shape_background_white_radiu_15dp"
                android:padding="15dp"
                android:layout_marginBottom="12dp">

                <!-- 标题栏-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设备信息"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_black_333333"
                       />
                    <!-- 刷新按钮 -->
                    <TextView
                        android:id="@+id/tv_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/refresh"
                        android:drawableLeft="@mipmap/ic_refresh_black"
                        android:textSize="14sp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/color_black_333333"
                        />
                </LinearLayout>


                <!-- 电池信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="电池电量："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_battery_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 系统时间 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="系统时间："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_sys_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textColor="@color/color_app_normal"
                        android:padding="5dp" />
                </LinearLayout>

                <!-- 固件版本 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="固件版本："
                        android:textSize="14sp"
                        />

                    <TextView
                        android:id="@+id/tv_firmware_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 网络信号强度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="网络信号："
                        android:textSize="14sp"
                        />

                    <TextView
                        android:id="@+id/tv_signal_strength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 探头水温 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="探头水温："
                        android:textSize="14sp"
                        />

                    <TextView
                        android:id="@+id/tv_water_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 存储空间 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="存储空间："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_storage_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                         />
                </LinearLayout>

                <!-- 设备名称 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设备名称："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                         />
                </LinearLayout>

                <!-- 设备MN号 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设备MN："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_device_mn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 设备状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设备状态："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_device_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textColor="@color/color_green_24ccaa"/>
                </LinearLayout>

                <!-- 工作模式 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="工作模式："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_work_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 运行模式 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="运行模式："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_run_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 蓝牙MAC地址 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="蓝牙地址："
                        android:textSize="14sp"
                         />

                    <TextView
                        android:id="@+id/tv_mac_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp" />
                </LinearLayout>


            </LinearLayout>

            </LinearLayout>
            <!-- 结束 ll_ui_mode -->

            <!-- 窗口模式容器 -->
            <LinearLayout
                android:id="@+id/ll_order_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="10dp">

                <!-- 日志显示区域 -->
                <ScrollView
                    android:id="@+id/scl_orders"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@drawable/shape_background_circle_blue_10dp"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/ll_orders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">
                    </LinearLayout>
                </ScrollView>

                <!-- 发送数据区域 -->
                <LinearLayout
                    android:id="@+id/bottom_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <!-- 清屏按钮 -->
                    <TextView
                        android:id="@+id/tv_clear_screen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_background"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="清屏"
                        android:textColor="@android:color/white"
                        android:layout_marginRight="5dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="4"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/sendData"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/edit_background"
                            android:hint="请输入指令内容"
                            android:textSize="14sp"
                            android:padding="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/send"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:background="@drawable/button_background"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="发送"
                            android:textColor="@android:color/white" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</LinearLayout>
