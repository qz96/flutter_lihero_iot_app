<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
     >

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:text="水泵控制命令"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:gravity="center"
        android:background="@drawable/shape_background_app_color_radiu_15dp_top"
         />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/color_white_ffffff"
        android:gravity="center_vertical"
        >
        <TextView
            android:id="@+id/tv_dev_bump1"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="水泵正转抽水"
            android:textColor="@color/color_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:gravity="center"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/color_white_ffffff"
        android:gravity="center_vertical"
        >
        <TextView
            android:id="@+id/tv_dev_bump2"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="水泵反转排水"
            android:textColor="@color/color_black_333333"
            android:textSize="16sp"
            android:padding="5dp"
            android:gravity="center"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/color_white_ffffff"
        android:gravity="center_vertical"
        >
        <TextView
            android:id="@+id/tv_dev_bump0"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="水泵停止工作"
            android:textColor="@color/color_black_333333"
            android:textSize="16sp"
            android:padding="5dp"
            android:gravity="center"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_bottom_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/shape_background_white_radiu_15dp_bottom"
        android:layout_below="@+id/tv_dlg_content">
        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="取 消"
            android:textSize="16sp"
            android:padding="15dp"
            android:gravity="center"
            />

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/color_white_e0e2e8"
        android:layout_alignTop="@+id/ll_bottom_btn"
        />

</LinearLayout>