<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rate_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <TextView
            android:id="@+id/send_byte_count_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送字节：0 Byte"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/receive_byte_count_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="接收字节：0 Byte"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/receive_rate_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="实时速率：0 B/s"
            android:textSize="10sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rate_layout"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志："
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">

            <TextView
                android:id="@+id/start_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_background"
                android:padding="5dp"
                android:text="开始测试"
				android:textStyle="italic"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stop_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="25dp"
                android:background="@drawable/button_background"
                android:padding="5dp"
                android:text="停止测试"
				android:textStyle="italic"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/clear_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_background"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:text="清 屏"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/top_layout"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="10"

            android:background="@drawable/shape_background_circle_blue_10dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/scroll_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
				android:paddingTop="10dp"
				android:paddingLeft="10dp"
				android:paddingRight="10dp"
				android:paddingBottom="30dp">

            </LinearLayout>

        </ScrollView>

    </LinearLayout>





    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sendData"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edit_background"
				android:textSize="14sp"
                android:hint="请输入十六进制数据" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:background="@drawable/button_background"
                android:text="发送"
				android:gravity="center"
				android:padding="10dp"
                android:textColor="@android:color/white" />


        </LinearLayout>

    </LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@+id/top_layout"
		android:orientation="vertical"
		android:paddingLeft="@dimen/activity_horizontal_margin"
		android:paddingTop="@dimen/activity_vertical_margin"
		android:paddingRight="@dimen/activity_horizontal_margin"
		android:paddingBottom="10dp">

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginBottom="@dimen/activity_vertical_margin"
			android:background="@color/colorSeparate" />



			<LinearLayout
				android:id="@+id/ll_manage_dev"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="样品编号：" />

					<TextView
						android:id="@+id/tv_sample_no"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="暂无数据"
						android:textColor="@color/color_app_light" />

					<TextView
						android:id="@+id/tv_set_sample_no"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:drawableLeft="@mipmap/ic_one_scan_black"
						android:gravity="center"
						android:padding="5dp"
						android:text=" 扫码设置\n 样品编号"
						android:textColor="@color/color_black_333333"
						android:textSize="11sp" />


				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="10dp"
					android:background="@color/colorSeparate" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:visibility="gone">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="蓝牙名称：" />

					<TextView
						android:id="@+id/tv_blue_name"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="暂无数据"
						android:textColor="@color/color_app_light" />

					<TextView
						android:id="@+id/tv_set_blue_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:drawableLeft="@mipmap/ic_one_scan_black"
						android:gravity="center"
						android:padding="5dp"
						android:text=" 扫码设置\n 蓝牙名称"
						android:textColor="@color/color_black_333333"
						android:textSize="11sp" />


				</LinearLayout>




				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="MAC地址：" />

					<TextView
						android:id="@+id/tv_mac_address"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="暂无数据"
						android:textColor="@color/color_app_light" />

					<TextView
						android:id="@+id/tv_set_mac_address"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:drawableLeft="@mipmap/ic_one_scan_black"
						android:gravity="center"
						android:padding="5dp"
						android:text=" 扫码设置\n Mac地址"
						android:textColor="@color/color_black_333333"
						android:textSize="11sp" />

				</LinearLayout>


				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="10dp"
					android:background="@color/colorSeparate" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:visibility="gone">
					<TextView
						android:id="@+id/tv_temperature"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:layout_marginLeft="15dp"
						android:background="@drawable/shape_background_green_radiu_10dp"
						android:padding="8dp"
						android:text="读取温度(°C)"
						android:textColor="@color/white"
						android:textSize="12sp"
						/>

					<TextView
						android:id="@+id/tv_electric_v"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:layout_marginLeft="80dp"
						android:background="@drawable/shape_background_app_color_radiu_10dp"
						android:padding="8dp"
						android:text="电池电压(V)"
						android:textColor="@color/white"
						android:textSize="12sp" />



				</LinearLayout>
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tv_read_sensor"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:background="@drawable/shape_background_app_color_radiu_10dp"
						android:padding="8dp"
						android:text="传感器读取"
						android:textColor="@color/white"
						android:textSize="11sp" />

					<TextView
						android:id="@+id/tv_set_lj"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:layout_marginLeft="20dp"
						android:background="@drawable/shape_background_orange_radiu_10dp"
						android:padding="8dp"
						android:text="交 样 运 输"
						android:textColor="@color/white"
						android:textSize="12sp" />

					<TextView
						android:id="@+id/tv_read_temp_array"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:layout_marginLeft="20dp"
						android:background="@drawable/shape_background_green_radiu_10dp"
						android:padding="8dp"
						android:text="温 度 记 录"
						android:textColor="@color/white"
						android:textSize="12sp" />

				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="10dp"
					android:background="@color/colorSeparate" />
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="上传设置：" />

					<TextView
						android:id="@+id/tv_update_cycle"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="请点击读取"
						android:textColor="@color/color_app_light" />
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="同步设置：" />

					<TextView
						android:id="@+id/tv_request_cycle"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="请点击读取"
						android:textColor="@color/color_app_light" />



				</LinearLayout>
				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="10dp"
					android:background="@color/colorSeparate" />
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="瓶盖状态：" />

					<TextView
						android:id="@+id/tv_bottle_state"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="请点击读取"
						android:textColor="@color/color_app_light" />
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="阀门状态：" />

					<TextView
						android:id="@+id/tv_tap_isclose"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:hint="请点击读取"
						android:textColor="@color/color_app_light" />



				</LinearLayout>
				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="10dp"
					android:background="@color/colorSeparate" />
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tv_set_tap"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:background="@drawable/shape_background_orange_radiu_10dp"
						android:padding="8dp"
						android:text="瓶阀状态重置"
						android:textColor="@color/white"
						android:textSize="11sp" />

					<TextView
						android:id="@+id/tv_open_tap"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:layout_marginLeft="20dp"
						android:background="@drawable/shape_background_green_radiu_10dp"
						android:padding="8dp"
						android:text="打开瓶阀"
						android:textColor="@color/white"
						android:textSize="12sp" />

					<TextView
						android:id="@+id/tv_close_tap"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:gravity="center"
						android:layout_height="wrap_content"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true"
						android:layout_marginLeft="20dp"
						android:background="@drawable/shape_background_app_color_radiu_10dp"
						android:padding="8dp"
						android:text="关 闭 瓶 阀"
						android:textColor="@color/white"
						android:textSize="12sp" />

				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="10dp"
					android:background="@color/colorSeparate" />

				<TextView
					android:id="@+id/tv_set_sample"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="配 置 采 样"
					android:gravity="center"
					android:padding="8dp"
					android:layout_marginLeft="10dp"
					android:layout_marginRight="10dp"
					android:layout_marginTop="10dp"
					android:textColor="@color/color_white_ffffff"
					android:background="@drawable/shape_background_pink_radiu_10dp"
					/>
			</LinearLayout>



	</LinearLayout>
</LinearLayout>
