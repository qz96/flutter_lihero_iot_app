<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

	<LinearLayout
		android:id="@+id/ll_login_content"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@+id/bg_videoView"
		android:orientation="vertical"
		android:layout_marginTop="100dp"
		android:padding="20dp"
		android:layout_marginLeft="25dp"
		android:layout_marginRight="25dp"
		android:background="@drawable/shape_background_circle_blue_10dp">
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/welcome_to_login_lhble"
			android:gravity="center"
			android:textSize="16sp"
			android:layout_marginTop="10dp"
			/>
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="30dp">
			<ImageView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="5dp"
				android:src="@mipmap/icon_user"
				/>
			<View
				android:layout_width="1dp"
				android:layout_height="fill_parent"
				android:layout_marginTop="3dp"
				android:layout_marginLeft="5dp"
				android:layout_marginBottom="3dp"
				android:layout_marginRight="5dp"
				android:background="@color/color_white_e0e2e8"
				/>

			<EditText
				android:id="@+id/ed_user_name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:hint="@string/input_username"
				android:textSize="14sp"
				android:paddingLeft="15dp"
				android:paddingRight="15dp"
				android:paddingTop="3dp"
				android:paddingBottom="3dp"
				android:maxLength="25"
				android:background="@null"
				/>
		</LinearLayout>
		<View
			android:layout_width="fill_parent"
			android:layout_height="1dp"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="20dp"
			android:background="@color/color_white_e0e2e8"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<ImageView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:src="@mipmap/icon_password"
				android:layout_marginLeft="5dp"
				/>

			<View
				android:layout_width="1dp"
				android:layout_height="fill_parent"
				android:layout_marginTop="3dp"
				android:layout_marginLeft="5dp"
				android:layout_marginBottom="3dp"
				android:layout_marginRight="5dp"
				android:background="@color/color_white_e0e2e8"/>

			<EditText
				android:id="@+id/ed_password"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:hint="@string/input_password"
				android:textSize="14sp"
				android:inputType="textPassword"
				android:paddingTop="3dp"
				android:paddingBottom="3dp"
				android:paddingLeft="15dp"
				android:paddingRight="15dp"
				android:maxLength="50"
				android:background="@null"
				/>

			<ImageView
				android:id="@+id/iv_pwd_show"
				android:layout_width="wrap_content"
				android:layout_height="fill_parent"
				android:paddingLeft="5dp"
				android:paddingRight="5dp"
				android:src="@mipmap/icon_eye"
				/>

		</LinearLayout>
		<View
			android:layout_width="fill_parent"
			android:layout_height="1dp"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="20dp"
			android:background="@color/color_white_e0e2e8"
			/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_marginBottom="20dp"
			android:gravity="center_vertical"
			android:visibility="gone">
			<ImageView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:src="@mipmap/icon_class"
				android:layout_marginLeft="5dp"
				/>
			<View
				android:layout_width="1dp"
				android:layout_height="fill_parent"
				android:layout_marginTop="3dp"
				android:layout_marginLeft="5dp"
				android:layout_marginBottom="3dp"
				android:layout_marginRight="5dp"
				android:background="@color/color_white_e0e2e8"/>

			<TextView
				android:id="@+id/tv_current_project"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:text="初始业务项目"
				android:textSize="14sp"
				android:paddingTop="3dp"
				android:paddingBottom="3dp"
				android:paddingLeft="15dp"
				android:paddingRight="15dp"
				/>
			<ImageView
				android:id="@+id/iv_select_project"
				android:layout_width="wrap_content"
				android:layout_height="fill_parent"
				android:paddingLeft="5dp"
				android:paddingRight="5dp"
				android:src="@mipmap/ic_arrow_down"
				/>
		</LinearLayout>


	</LinearLayout>


	<TextView
		android:id="@+id/tv_login"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:text="@string/login"
		android:textColor="@color/white"
		android:textSize="16sp"
		android:layout_marginLeft="25dp"
		android:layout_marginRight="25dp"
		android:layout_marginTop="80dp"
		android:background="@drawable/shape_background_app_color_radiu_10dp"
		android:padding="10dp"
		/>
	<View
		android:layout_width="wrap_content"
		android:layout_height="0dp"
		android:layout_weight="1"
		/>
	<TextView
		android:id="@+id/tv_app_version_info"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerHorizontal="true"
		android:layout_alignParentBottom="true"
		android:layout_marginBottom="10dp"
		android:textSize="11sp"
		android:layout_gravity="center_horizontal"
		android:text=""/>
</LinearLayout>
