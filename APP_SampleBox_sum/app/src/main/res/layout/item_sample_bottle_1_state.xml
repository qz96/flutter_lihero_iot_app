<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingLeft="10dp"
	android:paddingRight="10dp"
	android:paddingTop="15dp"
	>

<LinearLayout
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal">
	<RelativeLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

		<ImageView
			android:id="@+id/iv_sample_bottle"
			android:layout_width="80dp"
			android:layout_height="80dp"
			android:paddingLeft="3dp"
			android:paddingTop="4dp"
			android:paddingRight="4dp"
			android:paddingBottom="4dp"
			android:src="@mipmap/ic_sample_bottle" />

		<TextView
			android:id="@+id/tv_sample_bottle_num"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:paddingRight="1dp"
			android:paddingTop="5dp"
			android:text="1"
			android:textColor="@color/color_black_000000"
			android:textSize="24sp" />
		<ImageView
			android:id="@+id/iv_red_lock"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:src="@mipmap/ic_red_lock"
			android:layout_alignTop="@id/iv_sample_bottle"
			android:layout_alignRight="@id/iv_sample_bottle"
			/>
	</RelativeLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_time"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="00/00~00/00"
			android:textSize="15sp"
			android:textColor="@color/color_black_999999"/>
		<TextView
			android:id="@+id/tv_work_state"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="正常状态"
			android:layout_marginTop="5dp"
			android:textSize="16sp"
			android:textColor="@color/color_black_333333"/>
	</LinearLayout>
	<TextView
		android:id="@+id/tv_result_state"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text=""
		android:layout_gravity="center_vertical"
		android:layout_marginTop="3dp"
		android:textColor="@color/yellow"/>

</LinearLayout>



</LinearLayout>
