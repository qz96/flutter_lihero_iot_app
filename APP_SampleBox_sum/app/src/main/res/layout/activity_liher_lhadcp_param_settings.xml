<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <!-- 1. 压力水位计零点校准 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 压力水位计零点校准"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pressure_calibration"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/shape_background_app_color_radiu_10dp"
                android:text="一键校准（空气中）"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 2. 曲线系数ABC配置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 曲线系数ABC配置"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="公式：y = Ax² + Bx + C（用于流速修正）"
                android:textColor="#666666"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_coeff_a"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="曲线系数A"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_coeff_b"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="曲线系数B"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_coeff_c"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="曲线系数C"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save_coeff"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/shape_background_green_color_radiu_15dp"
                android:text="保存曲线系数"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 3. 恢复出厂设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. 恢复出厂设置"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_factory_reset"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/shape_background_orange_color_radiu_15dp"
                android:text="恢复出厂默认参数"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 4. 系统时间校准 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. 系统时间校准"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="默认为手机当前时间，可手动修改"
                android:textColor="#666666"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_sys_time"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="格式：yyMMddHHmmss（例：260624235959）"
                android:inputType="text"
                android:padding="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_set_phone_time"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_background_app_color_radiu_10dp"
                android:text="使用手机当前时间"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save_sys_time"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/shape_background_green_color_radiu_15dp"
                android:text="保存系统时间"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 5. 流量单位选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. 流量单位选择"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_flow_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_m3s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="m³/s"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_ls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="L/s"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- 6. 河底高程设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. 河底高程设置"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_elevation"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="单位：米（保留三位小数）"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save_elevation"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/shape_background_green_color_radiu_15dp"
                android:text="保存河底高程"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 7. 安装高度设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. 安装高度设置"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_install_height"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="单位：米（保留三位小数）"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save_install_height"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/shape_background_green_color_radiu_15dp"
                android:text="保存安装高度"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 8. 安装方向设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. 安装方向设置"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="正向（1）"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="反向（-1）"
                    android:textSize="14sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_save_direction"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/shape_background_green_color_radiu_15dp"
                android:text="保存安装方向"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
